{
	"version": "2.0.0",
	"tasks": [
		{
			"label": "Run booking full stack",
			"type": "shell",
			"command": "node",
			"args": [".vscode/debug-local.cjs"],
			"options": { "cwd": "${workspaceFolder}" },
			"isBackground": true,
			"problemMatcher": {
				"owner": "booking",
				"pattern": { "regexp": "^(?!)$", "file": 1, "message": 2 },
				"background": {
					"activeOnStart": true,
					"beginsPattern": "^.*Azure Functions Core Tools.*$",
					"endsPattern": "^BOOKING_READY http://localhost:[0-9]+$"
				}
			}
		},
		{
			"label": "Run Azure-backed booking application",
			"type": "shell",
			"command": "swa",
			"args": [
				"start",
				"app",
				"--api-devserver-url",
				"http://localhost:7071",
				"--swa-config-location",
				"app",
				"--port",
				"4281"
			],
			"isBackground": true,
			"problemMatcher": []
		},
		{
			"label": "Run booking Functions API",
			"type": "shell",
			"command": "func",
			"args": ["start", "--port", "7071"],
			"options": { "cwd": "${workspaceFolder}/api" },
			"isBackground": true,
			"problemMatcher": []
		}
	]
}